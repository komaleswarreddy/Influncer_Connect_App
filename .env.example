# Copy to `.env` in this folder (gitignored via root `.env` pattern).
# Values below mirror Financial-Accounting `finance-app` (Zopkit Kinde) — use the same EXPO_PUBLIC_KINDE_* as Finance for a shared Kinde application.

# Affiliate Fastify base URL — no trailing slash, no `/api` suffix (paths already include `/api/...`).
# You can keep http://localhost:3000: the app prefers Metro’s LAN host; on a physical Android + USB dev build,
# if Metro only shows 127.0.0.1, the app uses http://127.0.0.1:3000 — run `npm run adb:reverse` so that port
# forwards to your PC. Android emulator still uses 10.0.2.2 when no LAN host is found.
# Or set your LAN IP explicitly, e.g. http://192.168.1.10:3000, if you prefer not to rely on Metro discovery.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Kinde (same as finance-app)
EXPO_PUBLIC_KINDE_DOMAIN=https://auth.zopkit.com
EXPO_PUBLIC_KINDE_CLIENT_ID=677c5f681dc14c8fa1d42fbab550aeb6

# Optional: force Google (or another) connection — connection id from Kinde dashboard
# EXPO_PUBLIC_KINDE_CONNECTION_ID=

# Logout redirect — should match app.json `scheme` (e.g. affiliate-platform://)
EXPO_PUBLIC_KINDE_POST_LOGOUT_REDIRECT_URL=affiliate-platform://

# Production: false. Set true only for offline UI work without a backend.
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_USE_MOCK_API=false

# If you see: Cannot find module 'metro/src/lib/TerminalReporter'
# Run from this folder: npm install
# Then: npm run start:clear
# (Metro versions are pinned via package.json overrides; EXPO_NO_METRO_WORKSPACE_ROOT avoids parent-folder workspace confusion.)

# Tunnel: use `npm run start:tunnel` / `start:tunnel:dev-client` — they set EXPO_FORCE_WEBCONTAINER_ENV=1 so Expo uses
# the WebSocket tunnel (*.boltexpo.dev) instead of ngrok (avoids "ngrok tunnel took too long" / session-closed issues).
# WS tunnel requires Metro on port 8081; free the port if another process holds it.
# Optional ngrok-only tunnel: `npm run start:tunnel:ngrok` — optional EXPO_TUNNEL_TIMEOUT_MS (see patches/@expo+cli+*.patch).
# EXPO_TUNNEL_TIMEOUT_MS=180000

# USB + physical Android device (no tunnel / no LAN to PC for Metro):
# 1) Enable USB debugging, plug in phone, `adb devices` shows "device".
# 2) `npm run start:dev-client` — if adb sees a device, auto `adb reverse` for 8081 + 3000 and Metro --localhost (fixes "Failed to connect to 127.0.0.1:8081").
# 3) `npm run start:dev-client:usb` — force that USB/localhost path (EXPO_DEVCLIENT_USB=1).
# 4) Wi‑Fi only: no adb device (or EXPO_DEVCLIENT_LAN_ONLY=1) — same command uses LAN URLs for Metro.
# 5) Keep EXPO_PUBLIC_API_URL=http://localhost:3000 for a local API; reverse maps 3000 when a device is connected.
# Re-run `npm run adb:reverse` after unplugging USB if Metro stops connecting.
# `adb` is resolved via `scripts/adb-path.js` (%LOCALAPPDATA%\Android\platform-tools\adb.exe). Override with ADB_PATH if needed.
# `scripts/start-dev-client.js` sets ANDROID_HOME / PATH on Windows for child processes (same as the old start-expo-usb flow).

# Push notifications + in-app video (expo-notifications, expo-video) require a dev client build � not Expo Go.
# Rebuild after native dep changes: npm run build:apk:dev
