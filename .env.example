# Copy to `.env` in this folder (gitignored via root `.env` pattern).

# Affiliate Fastify base URL — no trailing slash, no `/api` suffix (paths already include `/api/...`).
# Prefer http://localhost:3003 (matches root PORT/BACKEND_URL). The app rewrites localhost to Metro’s
# LAN host on device; on physical Android + USB, if Metro only shows 127.0.0.1, the app uses
# http://127.0.0.1:3003 — run `npm run adb:reverse` so that port forwards to your PC.
# Android emulator still uses 10.0.2.2 when no LAN host is found.
# Or set your LAN IP explicitly, e.g. http://10.158.101.236:3003.
EXPO_PUBLIC_API_URL=http://localhost:3003

# --- AWS Cognito (mobile) — shared zopkit-platform pool ---
# Use affiliate-mobile-client — NOT the web client id. No client secret (PKCE).
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_Q4GGtslV8
EXPO_PUBLIC_COGNITO_DOMAIN=https://zopkit-platform-prod.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_COGNITO_CLIENT_ID=e6p8kt68jmir99akgnnr7d713
# Dev client / APK: custom scheme (must match Cognito callback URLs).
EXPO_PUBLIC_COGNITO_REDIRECT_URI=affiliateplatform://auth/callback
EXPO_PUBLIC_COGNITO_LOGOUT_URI=affiliate-platform://
# Cognito Allowed callback + logout (mobile) must include:
#   affiliateplatform://auth/callback
#   affiliate-platform://
#   exp://<YOUR-LAN-IP>:8081
#   exp://<YOUR-LAN-IP>:8081/--/
# Do NOT add exp://…/--/auth/callback — Cognito rejects it (redirect_mismatch).
# Expo Go auto-uses exp://<Metro-host>:8081/--/ (no /auth/callback path).

# Production: false. Set true only for offline UI work without a backend.
# Also hard-gated behind __DEV__ in lib/auth-config.ts — can never activate in a release build.
EXPO_PUBLIC_USE_MOCK_AUTH=false
EXPO_PUBLIC_USE_MOCK_API=false

# Sentry crash reporting (lib/sentry.ts) — unset disables it entirely.
# EXPO_PUBLIC_SENTRY_DSN=

# If you see: Cannot find module 'metro/src/lib/TerminalReporter'
# Run from this folder: npm install
# Then: npm run start:clear

# Tunnel: use `npm run start:tunnel` / `start:tunnel:dev-client` — they set EXPO_FORCE_WEBCONTAINER_ENV=1.
# WS tunnel requires Metro on port 8081; free the port if another process holds it.
# Optional ngrok-only tunnel: `npm run start:tunnel:ngrok`
# EXPO_TUNNEL_TIMEOUT_MS=180000

# USB + physical Android device (no tunnel / no LAN to PC for Metro):
# 1) Enable USB debugging, plug in phone, `adb devices` shows "device".
# 2) `npm run start:dev-client` — if adb sees a device, auto `adb reverse` for 8081 + 3003.
# 3) `npm run start:dev-client:usb` — force that USB/localhost path (EXPO_DEVCLIENT_USB=1).
# 4) Wi‑Fi only: no adb device (or EXPO_DEVCLIENT_LAN_ONLY=1) — same command uses LAN URLs for Metro.
# 5) Keep EXPO_PUBLIC_API_URL=http://localhost:3003 for a local API; reverse maps 3003 when a device is connected.
# Re-run `npm run adb:reverse` after unplugging USB if Metro stops connecting.
# `adb` is resolved via `scripts/adb-path.js`. Override with ADB_PATH if needed.

# Push notifications + in-app video (expo-notifications, expo-video) require a dev client build — not Expo Go.
# Rebuild after native dep changes: npm run build:apk:dev
