{
  "expo": {
    "name": "Influencer Connect",
    "slug": "affiliate-platform",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/App_icon.png",
    "scheme": "affiliateplatform",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.affiliateplatform.app",
      "infoPlist": {
        "CFBundleURLTypes": [{ "CFBundleURLSchemes": ["affiliate-platform"] }]
      }
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/App_icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.affiliateplatform.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "affiliateplatform",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "affiliateplatform" }, { "scheme": "affiliate-platform" }]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/App_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "",
      "useMockAuth": false,
      "useMockApi": false,
      "cognitoRegion": "",
      "cognitoUserPoolId": "",
      "cognitoDomain": "",
      "cognitoClientId": "",
      "cognitoRedirectUri": "",
      "cognitoLogoutUri": "",
      "router": {},
      "eas": {
        "projectId": "d3840417-c495-4426-aa7e-c1567e0079f4"
      }
    },
    "owner": "komalz"
  }
}
